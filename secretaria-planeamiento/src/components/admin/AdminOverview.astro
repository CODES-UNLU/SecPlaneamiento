---
/**
 * Componente: AdminOverview
 * Vista de resumen / Inicio del Dashboard de Administración
 */
---

<div class="space-y-8">
  <!-- Banner de bienvenida -->
  <div class="bg-gradient-to-r from-unlu-green-dark via-unlu-green to-emerald-800 text-white rounded-2xl p-6 sm:p-8 shadow-xl relative overflow-hidden">
    <div class="absolute -right-10 -bottom-10 opacity-10 pointer-events-none">
      <img src="/escudo.svg" alt="" class="w-64 h-64 invert" />
    </div>
    <div class="relative z-10 max-w-3xl">
      <div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-md px-3 py-1 rounded-full text-xs font-semibold text-unlu-gold border border-white/20 mb-4">
        <span>Panel de Control Institucional</span>
        <span>•</span>
        <span>Módulos Operativos</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-bold tracking-tight text-white font-sans mb-2">
        Bienvenido/a, usuplanea 👋
      </h1>
      <p class="text-emerald-100 text-sm sm:text-base leading-relaxed">
        Gestión centralizada de contenidos dinámicos, documentos oficiales y canales de atención de la Secretaría de Planeamiento.
      </p>

      <div class="flex flex-wrap items-center gap-3 mt-6">
        <button
          onclick="window.switchTab('editor'); setTimeout(() => window.switchModule && window.switchModule('documents'), 50);"
          class="inline-flex items-center gap-2 bg-unlu-gold hover:bg-unlu-gold-light text-slate-900 font-bold px-4 py-2.5 rounded-xl shadow-md transition-all transform hover:-translate-y-0.5 text-sm cursor-pointer"
        >
          <span>📄 Repositorio de Documentos</span>
        </button>

        <button
          onclick="window.switchTab('editor'); setTimeout(() => window.switchModule && window.switchModule('convocatoria'), 50);"
          class="inline-flex items-center gap-2 bg-white/15 hover:bg-white/25 text-white font-medium px-4 py-2.5 rounded-xl backdrop-blur-md transition-all text-sm border border-white/20 cursor-pointer"
        >
          <span>📋 Convocatorias & Formulario PDI</span>
        </button>

        <button
          onclick="window.switchTab('editor'); setTimeout(() => window.switchModule && window.switchModule('banner'), 50);"
          class="inline-flex items-center gap-2 bg-white/10 hover:bg-white/20 text-emerald-100 font-medium px-4 py-2.5 rounded-xl transition-all text-sm cursor-pointer"
        >
          <span>📢 Avisos & Banners</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Tarjetas de Métricas -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
    <!-- Métrica 1 -->
    <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-xs hover:shadow-md transition-shadow">
      <div class="flex items-center justify-between mb-3">
        <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Módulos Dinámicos</span>
        <div class="w-10 h-10 rounded-xl bg-emerald-50 text-unlu-green flex items-center justify-center">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
          </svg>
        </div>
      </div>
      <div class="flex items-baseline gap-2">
        <span class="text-3xl font-bold text-slate-900">5</span>
        <span class="text-xs font-medium text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-full">Activos</span>
      </div>
      <p class="text-xs text-slate-500 mt-2">Avisos, Docs, PDI, Contacto, Novedades</p>
    </div>

    <!-- Métrica 2 -->
    <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-xs hover:shadow-md transition-shadow">
      <div class="flex items-center justify-between mb-3">
        <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Documentos & Resoluciones</span>
        <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
          </svg>
        </div>
      </div>
      <div class="flex items-baseline gap-2">
        <span class="text-3xl font-bold text-slate-900">3</span>
        <span class="text-xs font-medium text-amber-700 bg-amber-50 px-2 py-0.5 rounded-full">Oficiales HCS</span>
      </div>
      <p class="text-xs text-slate-500 mt-2">Disponibles en PDF para descarga</p>
    </div>

    <!-- Métrica 3 -->
    <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-xs hover:shadow-md transition-shadow">
      <div class="flex items-center justify-between mb-3">
        <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Convocatoria PDI</span>
        <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
        </div>
      </div>
      <div class="flex items-baseline gap-2">
        <span class="text-xl font-bold text-slate-900">Abierta</span>
        <span class="text-xs font-medium text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-full">Google Forms</span>
      </div>
      <p class="text-xs text-slate-500 mt-2">Recepción continua de propuestas</p>
    </div>

    <!-- Métrica 4 -->
    <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-xs hover:shadow-md transition-shadow">
      <div class="flex items-center justify-between mb-3">
        <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Estado Portal</span>
        <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </div>
      </div>
      <div class="flex items-baseline gap-2">
        <span class="text-xl font-bold text-slate-900">100% Online</span>
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-ping"></span>
      </div>
      <p class="text-xs text-slate-500 mt-2">Estatutos & normativas resguardados</p>
    </div>
  </div>

  <!-- Sección Central: Accesos Directos a Módulos Operativos -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

    <!-- Módulos Operativos (2 columnas) -->
    <div class="lg:col-span-2 bg-white rounded-2xl p-6 border border-slate-200/80 shadow-xs space-y-5">
      <div class="flex items-center justify-between border-b border-slate-100 pb-4">
        <div>
          <h2 class="text-lg font-bold text-slate-900 font-sans">Módulos de Gestión Operativa</h2>
          <p class="text-xs text-slate-500">Accedé directamente al módulo que requerís actualizar</p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <!-- Tarjeta 1: Avisos & Banners -->
        <div class="p-4 rounded-xl border border-slate-200/80 hover:border-unlu-green/50 hover:bg-slate-50 transition-all flex flex-col justify-between group">
          <div>
            <div class="w-9 h-9 rounded-lg bg-amber-100 text-amber-800 flex items-center justify-center font-bold text-lg mb-2.5">
              📢
            </div>
            <h3 class="text-sm font-bold text-slate-900 group-hover:text-unlu-green transition-colors">Avisos & Banners de Alerta</h3>
            <p class="text-xs text-slate-500 mt-1">Activa y modifica el aviso destacado que aparece en la parte superior del portal.</p>
          </div>
          <button
            onclick="window.switchTab('editor'); setTimeout(() => window.switchModule && window.switchModule('banner'), 50);"
            class="mt-4 inline-flex items-center justify-center gap-1.5 bg-slate-100 hover:bg-unlu-green text-slate-700 hover:text-white font-bold text-xs py-2 rounded-lg transition-colors cursor-pointer"
          >
            <span>Configurar Banner →</span>
          </button>
        </div>

        <!-- Tarjeta 2: Documentos & Resoluciones -->
        <div class="p-4 rounded-xl border border-slate-200/80 hover:border-unlu-green/50 hover:bg-slate-50 transition-all flex flex-col justify-between group">
          <div>
            <div class="w-9 h-9 rounded-lg bg-emerald-100 text-unlu-green flex items-center justify-center font-bold text-lg mb-2.5">
              📄
            </div>
            <h3 class="text-sm font-bold text-slate-900 group-hover:text-unlu-green transition-colors">Documentos & Resoluciones HCS</h3>
            <p class="text-xs text-slate-500 mt-1">Agrega nuevas resoluciones, informes de autoevaluación y archivos descargables.</p>
          </div>
          <button
            onclick="window.switchTab('editor'); setTimeout(() => window.switchModule && window.switchModule('documents'), 50);"
            class="mt-4 inline-flex items-center justify-center gap-1.5 bg-slate-100 hover:bg-unlu-green text-slate-700 hover:text-white font-bold text-xs py-2 rounded-lg transition-colors cursor-pointer"
          >
            <span>Gestionar Documentos →</span>
          </button>
        </div>

        <!-- Tarjeta 3: Convocatorias & PDI -->
        <div class="p-4 rounded-xl border border-slate-200/80 hover:border-unlu-green/50 hover:bg-slate-50 transition-all flex flex-col justify-between group">
          <div>
            <div class="w-9 h-9 rounded-lg bg-blue-100 text-blue-800 flex items-center justify-center font-bold text-lg mb-2.5">
              📋
            </div>
            <h3 class="text-sm font-bold text-slate-900 group-hover:text-unlu-green transition-colors">Formulario de Proyectos PDI</h3>
            <p class="text-xs text-slate-500 mt-1">Modifica el enlace al Google Forms, los plazos de cierre y la guía para claustros.</p>
          </div>
          <button
            onclick="window.switchTab('editor'); setTimeout(() => window.switchModule && window.switchModule('convocatoria'), 50);"
            class="mt-4 inline-flex items-center justify-center gap-1.5 bg-slate-100 hover:bg-unlu-green text-slate-700 hover:text-white font-bold text-xs py-2 rounded-lg transition-colors cursor-pointer"
          >
            <span>Ajustar Convocatoria →</span>
          </button>
        </div>

        <!-- Tarjeta 4: Contacto e Internos -->
        <div class="p-4 rounded-xl border border-slate-200/80 hover:border-unlu-green/50 hover:bg-slate-50 transition-all flex flex-col justify-between group">
          <div>
            <div class="w-9 h-9 rounded-lg bg-purple-100 text-purple-800 flex items-center justify-center font-bold text-lg mb-2.5">
              📞
            </div>
            <h3 class="text-sm font-bold text-slate-900 group-hover:text-unlu-green transition-colors">Canales de Contacto, Internos & FAQ</h3>
            <p class="text-xs text-slate-500 mt-1">Actualiza los internos de Despacho (1718), Mesa (1200), correos y preguntas frecuentes.</p>
          </div>
          <button
            onclick="window.switchTab('editor'); setTimeout(() => window.switchModule && window.switchModule('contacto'), 50);"
            class="mt-4 inline-flex items-center justify-center gap-1.5 bg-slate-100 hover:bg-unlu-green text-slate-700 hover:text-white font-bold text-xs py-2 rounded-lg transition-colors cursor-pointer"
          >
            <span>Editar Contactos & FAQ →</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Timeline de Historial / Actividad Reciente -->
    <div class="bg-white rounded-2xl p-6 border border-slate-200/80 shadow-xs space-y-5">
      <div class="border-b border-slate-100 pb-4">
        <h2 class="text-lg font-bold text-slate-900 font-sans">Historial de Actividad</h2>
        <p class="text-xs text-slate-500">Últimas acciones realizadas en el panel</p>
      </div>

      <div class="relative pl-6 space-y-6 before:absolute before:left-2 before:top-2 before:bottom-2 before:w-0.5 before:bg-slate-200">
        <!-- Evento 1 -->
        <div class="relative">
          <div class="absolute -left-[23px] top-1 w-3.5 h-3.5 rounded-full bg-unlu-green border-2 border-white ring-2 ring-emerald-100"></div>
          <div>
            <p class="text-xs font-semibold text-slate-900">Módulos operativos optimizados</p>
            <p class="text-[11px] text-slate-500 mt-0.5">Por <strong class="text-slate-700">usuplanea</strong> • Hoy</p>
            <span class="inline-block mt-1 text-[10px] text-emerald-800 bg-emerald-50 px-2 py-0.5 rounded font-mono">Panel enfocado</span>
          </div>
        </div>

        <!-- Evento 2 -->
        <div class="relative">
          <div class="absolute -left-[23px] top-1 w-3.5 h-3.5 rounded-full bg-amber-500 border-2 border-white ring-2 ring-amber-100"></div>
          <div>
            <p class="text-xs font-semibold text-slate-900">Resolución incorporada: RESHCS 492/2026</p>
            <p class="text-[11px] text-slate-500 mt-0.5">Plan Decenal PDI 2026–2036</p>
            <span class="inline-block mt-1 text-[10px] text-amber-800 bg-amber-50 px-2 py-0.5 rounded font-mono">Repositorio PDF</span>
          </div>
        </div>

        <!-- Evento 3 -->
        <div class="relative">
          <div class="absolute -left-[23px] top-1 w-3.5 h-3.5 rounded-full bg-blue-500 border-2 border-white ring-2 ring-blue-100"></div>
          <div>
            <p class="text-xs font-semibold text-slate-900">Internos de atención actualizados</p>
            <p class="text-[11px] text-slate-500 mt-0.5">Int. 1718 (Despacho) / 1200 (Mesa)</p>
            <span class="inline-block mt-1 text-[10px] text-blue-800 bg-blue-50 px-2 py-0.5 rounded font-mono">Canales directos</span>
          </div>
        </div>
      </div>

      <div class="pt-2 border-t border-slate-100">
        <a href="/admin?tab=profile" class="text-xs text-slate-600 hover:text-unlu-green font-medium flex items-center gap-1 justify-center">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
          <span>Ver perfil de usuplanea</span>
        </a>
      </div>
    </div>

  </div>
</div>
