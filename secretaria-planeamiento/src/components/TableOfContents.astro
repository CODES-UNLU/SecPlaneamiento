---
/**
 * Componente: TableOfContents
 * Tabla de contenidos flotante/sticky para páginas institucionales extensas.
 */
interface HeadingItem {
  id: string;
  title: string;
}

interface Props {
  items: HeadingItem[];
}

const { items = [] } = Astro.props;
---

{items.length > 0 && (
  <nav class="hidden xl:block w-72 shrink-0" aria-label="Tabla de contenidos">
    <div class="sticky top-28 bg-white rounded-xl border border-slate-200 p-5 shadow-xs">
      <div class="flex items-center gap-2 mb-3 pb-2 border-b border-slate-100">
        <svg class="w-4 h-4 text-unlu-green" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" />
        </svg>
        <span class="text-xs font-bold uppercase tracking-wider text-slate-700">En esta página</span>
      </div>

      <ul class="space-y-1 text-xs">
        {items.map((it) => (
          <li>
            <a
              href={`#${it.id}`}
              class="toc-link block py-1.5 px-2 rounded text-slate-600 hover:text-unlu-green hover:bg-slate-50 transition leading-snug"
              data-target-id={it.id}
            >
              {it.title}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>
)}

<script is:inline>
  (function() {
    const links = document.querySelectorAll('.toc-link');
    if (!links.length) return;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const id = entry.target.getAttribute('id');
          links.forEach((link) => {
            if (link.getAttribute('data-target-id') === id) {
              link.classList.add('font-bold', 'text-unlu-green', 'bg-emerald-50', 'border-l-2', 'border-unlu-green');
              link.classList.remove('text-slate-600');
            } else {
              link.classList.remove('font-bold', 'text-unlu-green', 'bg-emerald-50', 'border-l-2', 'border-unlu-green');
              link.classList.add('text-slate-600');
            }
          });
        }
      });
    }, { rootMargin: '-80px 0px -70% 0px' });

    links.forEach((link) => {
      const id = link.getAttribute('data-target-id');
      const target = document.getElementById(id);
      if (target) observer.observe(target);
    });
  })();
</script>
