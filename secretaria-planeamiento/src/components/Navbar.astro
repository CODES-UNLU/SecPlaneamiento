  function normalize(str: string): string {
    return str
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .toLowerCase()
      .trim();
  }

  function search(query: string): SearchItem[] {
    const rawQ = normalize(query);
    if (!rawQ || rawQ.length < 2) return [];

    const tokens = rawQ.split(/\s+/).filter(t => t.length > 0);

    const scored = SEARCH_INDEX.map(item => {
      let score = 0;
      const titleNorm = normalize(item.title);
      const categoryNorm = normalize(item.category);
      const snippetNorm = normalize(item.snippet);
      const keywordsNorm = item.keywords.map(k => normalize(k)).join(" ");

      // Exact phrase match in title
      if (titleNorm.includes(rawQ)) score += 100;
      // Exact phrase in category or keywords
      if (keywordsNorm.includes(rawQ)) score += 60;
      if (snippetNorm.includes(rawQ)) score += 40;

      // Token matches
      tokens.forEach(tok => {
        if (titleNorm.includes(tok)) score += 30;
        if (keywordsNorm.includes(tok)) score += 20;
        if (snippetNorm.includes(tok)) score += 10;
        if (categoryNorm.includes(tok)) score += 15;
      });

      return { item, score };
    });

    return scored
      .filter(s => s.score > 0)
      .sort((a, b) => b.score - a.score)
      .map(s => s.item);
  }

  function highlightMatches(text: string, query: string): string {
    if (!query) return text;
    const tokens = normalize(query).split(/\s+/).filter(t => t.length > 0);
    if (tokens.length === 0) return text;
    const pattern = new RegExp(`(${tokens.map(t => t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|')})`, 'gi');
    return text.replace(pattern, '<mark class="bg-amber-200 text-gray-900 rounded-xs px-0.5 font-bold">$1</mark>');
  }

  function renderSearchResults(results: SearchItem[], query: string, containerEl: HTMLElement | null) {
    if (!containerEl) return;
    if (!query || query.trim().length < 2) {
      containerEl.classList.add('hidden');
      containerEl.innerHTML = '';
      return;
    }

    containerEl.classList.remove('hidden');

    if (results.length === 0) {
      containerEl.innerHTML = `
        <div class="p-4 text-center text-xs text-gray-500">
          <p class="font-bold text-gray-700 mb-1">No se encontraron resultados para "${query}"</p>
          <p class="text-[11px] text-gray-400">Intenta buscando: <span class="font-semibold text-unlu-green">SIAC, PDI, tutorías, encuestas, resoluciones</span></p>
        </div>
      `;
      return;
    }

    const header = `
      <div class="px-3 py-1.5 bg-gray-50 text-[10px] font-bold uppercase tracking-wider text-gray-500 flex items-center justify-between border-b border-gray-100">
        <span>${results.length} resultado${results.length > 1 ? 's' : ''} encontrado${results.length > 1 ? 's' : ''}</span>
        <span class="text-[9px] text-gray-400">Presiona Enter para ir</span>
      </div>
    `;

    const itemsHtml = results.slice(0, 6).map((res, idx) => `
      <a
        href="${res.url}"
        target="${res.isExternal ? '_blank' : '_self'}"
        class="search-result-item block p-3 hover:bg-emerald-50/60 transition-colors cursor-pointer group ${idx === 0 ? 'bg-emerald-50/30' : ''}"
        data-index="${idx}"
      >
        <div class="flex items-center gap-2 mb-1">
          <span class="text-[10px] font-bold px-2 py-0.5 rounded-full border ${res.badgeColor}">
            ${res.category}
          </span>
          <span class="text-xs font-bold text-gray-900 group-hover:text-unlu-green font-sans leading-tight">
            ${highlightMatches(res.title, query)}
          </span>
          ${res.isExternal ? '<span class="text-[10px] text-red-600 font-bold ml-auto">PDF ↗</span>' : ''}
        </div>
        <p class="text-[11px] text-gray-600 line-clamp-2 leading-relaxed">
          ${highlightMatches(res.snippet, query)}
        </p>
      </a>
    `).join('');

    containerEl.innerHTML = header + itemsHtml;
  }

  // --- CONFIGURACIÓN DE BUSCADOR DESKTOP ---
  const searchInput = document.getElementById('nav-search-input') as HTMLInputElement | null;
  const searchForm = document.getElementById('nav-search-form') as HTMLFormElement | null;
  const searchResults = document.getElementById('nav-search-results');
  const searchClear = document.getElementById('nav-search-clear');
  const searchContainer = document.getElementById('nav-search-container');

  let activeDesktopResults: SearchItem[] = [];

  if (searchInput && searchResults) {
    searchInput.addEventListener('input', () => {
      const q = searchInput.value.trim();
      if (searchClear) {
        if (q.length > 0) searchClear.classList.remove('hidden');
        else searchClear.classList.add('hidden');
      }
      activeDesktopResults = search(q);
      renderSearchResults(activeDesktopResults, q, searchResults);
    });

    searchInput.addEventListener('focus', () => {
      if (searchInput.value.trim().length >= 2) {
        activeDesktopResults = search(searchInput.value.trim());
        renderSearchResults(activeDesktopResults, searchInput.value.trim(), searchResults);
      }
    });

    if (searchClear) {
      searchClear.addEventListener('click', () => {
        searchInput.value = '';
        searchClear.classList.add('hidden');
        searchResults.classList.add('hidden');
        searchInput.focus();
      });
    }

    if (searchForm) {
      searchForm.addEventListener('submit', (e) => {
        e.preventDefault();
        if (activeDesktopResults.length > 0) {
          const first = activeDesktopResults[0];
          if (first.isExternal) {
            window.open(first.url, '_blank');
          } else {
            window.location.href = first.url;
          }
          searchResults.classList.add('hidden');
        }
      });
    }

    // Cerrar al hacer clic afuera
    document.addEventListener('click', (e) => {
      if (searchContainer && !searchContainer.contains(e.target as Node)) {
        searchResults.classList.add('hidden');
      }
    });

    // Atajos de teclado: Escape para cerrar, Ctrl+K o '/' para enfocar buscador
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && searchResults) {
        searchResults.classList.add('hidden');
      }
      if ((e.ctrlKey && e.key === 'k') || (e.key === '/' && document.activeElement !== searchInput && !(e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement))) {
        e.preventDefault();
        searchInput.focus();
      }
    });
  }

  // --- CONFIGURACIÓN DE BUSCADOR MOBILE ---
  const mobileSearchInput = document.getElementById('mobile-search-input') as HTMLInputElement | null;
  const mobileSearchResults = document.getElementById('mobile-search-results');
  const mobileSearchSubmit = document.getElementById('mobile-search-submit');

  let activeMobileResults: SearchItem[] = [];

  if (mobileSearchInput && mobileSearchResults) {
    mobileSearchInput.addEventListener('input', () => {
      const q = mobileSearchInput.value.trim();
      activeMobileResults = search(q);
      renderSearchResults(activeMobileResults, q, mobileSearchResults);
    });

    if (mobileSearchSubmit) {
      mobileSearchSubmit.addEventListener('click', () => {
        if (activeMobileResults.length > 0) {
          const first = activeMobileResults[0];
          closeMenu();
          if (first.isExternal) {
            window.open(first.url, '_blank');
          } else {
            window.location.href = first.url;
          }
        }
      });
    }
  }
