---
/**
 * Componente: Navbar Institucional (2 niveles)
 * Nivel 1: Barra blanca con logo UNLu (escudo), título y buscador accesible con atajo de teclado.
 * Línea divisoria tricolor institucional.
 * Nivel 2: Barra verde institucional con links de navegación accesibles por teclado (focus-within) y dropdowns.
 */
interface Props {
  activeSection?: string;
}

const { activeSection = "" } = Astro.props;

const navLinks = [
  {
    name: "La Secretaría",
    href: "/la-secretaria",
    id: "la-secretaria",
    hasDropdown: true,
    subItems: [
      { name: "Misión, Visión y Valores", href: "/la-secretaria#mision" },
      { name: "Autoridades y equipo", href: "/la-secretaria#autoridades" },
      { name: "Los ODS y UNLu Sostenible", href: "/la-secretaria#ods-sostenible" },
      { name: "Actividades", href: "/la-secretaria#actividades" },
    ],
  },
  {
    name: "Autoevaluación Institucional",
    href: "/autoevaluacion",
    id: "autoevaluacion",
    hasDropdown: true,
    subItems: [
      { name: "Informe de Autoevaluación", href: "/autoevaluacion#informe" },
      { name: "Video de Sensibilización", href: "/autoevaluacion#block-sensibilizacion" },
      { name: "Encuestas y análisis", href: "/autoevaluacion#encuestas" },
      { name: "Entrevistas", href: "/autoevaluacion#entrevistas" },
    ],
  },
  {
    name: "Plan de Desarrollo Institucional",
    href: "/plan-desarrollo",
    id: "plan-desarrollo",
    hasDropdown: true,
    subItems: [
      { name: "¿Qué es el PDI?", href: "/plan-desarrollo#pdi" },
      { name: "Metodología y Diagnóstico", href: "/plan-desarrollo#metodologia-diagnostico" },
      { name: "6 Dimensiones Estratégicas", href: "/plan-desarrollo#dimensiones" },
      { name: "Beneficios por Claustro", href: "/plan-desarrollo#beneficios-claustros" },
      { name: "Presentación de Proyectos", href: "/plan-desarrollo#pdi-banner-form-proyectos" },
      { name: "Repositorio y Normativa", href: "/plan-desarrollo#pdi-documentos-oficiales" },
      { name: "Metas al 2036 y SIAC", href: "/plan-desarrollo#metas-monitoreo" },
    ],
  },
  {
    name: "SIAC",
    href: "/siac",
    id: "siac",
    hasDropdown: true,
    subItems: [
      { name: "¿Qué es el SIAC?", href: "/siac#que-es" },
      { name: "Beneficios y Objetivos", href: "/siac#beneficios" },
      { name: "¿A quién está orientado?", href: "/siac#destinatarios" },
      { name: "Estructura y Gestión", href: "/siac#gestion" },
      { name: "Marco Normativo", href: "/siac#marco-normativo" },
    ],
  },
  {
    name: "Contacto",
    href: "/contacto",
    id: "contacto",
    hasDropdown: true,
    subItems: [
      { name: "Cómo llegar y Horarios", href: "/contacto#atencion-card" },
      { name: "Formulario de consulta", href: "/contacto#contact-form" },
    ],
  },
];
---

<header class="sticky top-0 z-50 shadow-md">
  <!-- Barra superior institucional negra (accesos rápidos UNLu) -->
  <div class="hidden md:block bg-black text-white text-xs py-1.5 border-b border-gray-800" aria-label="Enlaces institucionales directos">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between">
      <div class="flex items-center gap-6">
        <a href="https://www.unlu.edu.ar/" target="_blank" rel="noopener noreferrer" class="text-gray-300 hover:text-white transition-colors focus:underline focus:outline-none">Portal UNLu</a>
        <a href="https://rectorado.unlu.edu.ar/" target="_blank" rel="noopener noreferrer" class="text-gray-300 hover:text-white transition-colors focus:underline focus:outline-none">Rectorado</a>
      </div>
      <div class="flex items-center gap-6">
        <a href="https://webmail.unlu.edu.ar/" target="_blank" rel="noopener noreferrer" class="text-gray-300 hover:text-white transition-colors focus:underline focus:outline-none">Webmail</a>
        <a href="https://www.unlu.edu.ar/acceso-aulas-virtuales.html" target="_blank" rel="noopener noreferrer" class="text-gray-300 hover:text-white transition-colors focus:underline focus:outline-none">Aulas Virtuales</a>
        <a href="https://www.biblioteca.unlu.edu.ar/" target="_blank" rel="noopener noreferrer" class="text-gray-300 hover:text-white transition-colors focus:underline focus:outline-none">Biblioteca</a>
        <a href="/admin" id="nav-admin-link" class="text-unlu-gold font-bold hover:underline flex items-center gap-1 bg-unlu-green/20 px-2 py-0.5 rounded border border-unlu-gold/30 focus:ring-2 focus:ring-unlu-gold">
          <span>🔑 Iniciar Sesión</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Nivel 1: Barra blanca con logo y buscador -->
  <div class="bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-20">
        
        <!-- Logo + Título -->
        <a href="/" class="flex items-center gap-3 group focus:outline-none focus:ring-2 focus:ring-unlu-green rounded-lg p-1" aria-label="Página de inicio - Secretaría de Planeamiento UNLu">
          <img 
            src="/escudo.svg" 
            alt="Escudo oficial de la Universidad Nacional de Luján" 
            class="w-12 h-12 rounded-full border-2 border-unlu-gold/30 shadow-sm"
          />
          <div class="flex flex-col">
            <span class="text-lg sm:text-xl font-bold tracking-tight text-gray-900 font-sans">Secretaría de Planeamiento</span>
            <span class="text-[10px] sm:text-xs font-semibold uppercase tracking-[0.15em] text-gray-500">Universidad Nacional de Luján · Rectorado</span>
          </div>
        </a>

        <!-- Buscador con resultados instantáneos (desktop) -->
        <div class="hidden md:flex items-center relative" id="nav-search-container">
          <form id="nav-search-form" class="flex items-center rounded-lg overflow-hidden shadow-xs border border-gray-300 focus-within:border-unlu-green focus-within:ring-2 focus-within:ring-unlu-green/20 transition-all bg-gray-100" role="search" aria-label="Buscador del portal">
            <div class="relative flex items-center">
              <input
                type="search"
                id="nav-search-input"
                placeholder="Buscar en el portal..."
                autocomplete="off"
                aria-label="Buscar en el portal institucional"
                aria-autocomplete="list"
                aria-controls="nav-search-results"
                class="px-3.5 py-2 text-sm text-gray-800 placeholder:text-gray-400 bg-transparent focus:outline-none w-44 lg:w-64 transition-all"
              />
              <kbd class="hidden lg:inline-flex items-center gap-0.5 text-[10px] font-semibold text-gray-400 bg-white border border-gray-200 px-1.5 py-0.5 rounded shadow-xs mr-2 pointer-events-none" title="Atajo de teclado">
                Ctrl K
              </kbd>
              <button
                type="button"
                id="nav-search-clear"
                class="hidden text-gray-400 hover:text-gray-600 px-1.5 py-1 text-xs"
                title="Limpiar búsqueda"
                aria-label="Limpiar campo de búsqueda"
              >✕</button>
            </div>
            <button
              type="submit"
              id="nav-search-submit"
              class="bg-unlu-green hover:bg-unlu-green-dark text-white px-3 py-[9px] transition-colors duration-200 shrink-0 cursor-pointer focus:outline-none focus:ring-2 focus:ring-unlu-gold"
              aria-label="Ejecutar búsqueda"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </button>
          </form>

          <!-- Dropdown flotante de resultados en vivo (desktop) -->
          <div
            id="nav-search-results"
            role="region"
            aria-live="polite"
            class="hidden absolute right-0 top-full mt-2 w-96 max-h-96 overflow-y-auto bg-white rounded-xl shadow-2xl border border-gray-200 divide-y divide-gray-100 z-50 transition-all"
          >
            <!-- Renderizado dinámico vía JS -->
          </div>
        </div>

        <!-- Botón menú mobile -->
        <button
          id="mobile-menu-button"
          type="button"
          class="md:hidden inline-flex items-center justify-center p-2 rounded-lg text-gray-700 hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-unlu-green"
          aria-controls="mobile-menu"
          aria-expanded="false"
          aria-label="Abrir menú de navegación"
        >
          <svg class="h-6 w-6 block" id="menu-icon-open" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
          </svg>
          <svg class="h-6 w-6 hidden" id="menu-icon-close" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Línea divisoria tricolor institucional de 3px -->
  <div class="flex h-[3px] w-full" aria-hidden="true">
    <div class="h-full bg-unlu-green w-[33.33%]"></div>
    <div class="h-full bg-unlu-gold w-[33.34%]"></div>
    <div class="h-full bg-unlu-red w-[33.33%]"></div>
  </div>

  <!-- Nivel 2: Barra verde con navegación accesible -->
  <nav class="hidden md:block bg-unlu-green-dark" aria-label="Navegación principal">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center h-12">
        {navLinks.map((link) => {
          const isActive = activeSection === link.id;
          return (
            <div class="relative group focus-within:z-50">
              <a
                href={link.href}
                aria-haspopup={link.hasDropdown ? "true" : undefined}
                aria-current={isActive ? "page" : undefined}
                class:list={[
                  "inline-flex items-center gap-1.5 px-4 text-sm font-medium transition-colors border-b-2 focus:outline-none focus:ring-2 focus:ring-unlu-gold focus:ring-inset",
                  isActive
                    ? "text-unlu-gold bg-unlu-green border-unlu-gold font-bold pt-3 pb-3.5"
                    : "text-white hover:text-unlu-gold hover:bg-unlu-green border-transparent pt-3.5 pb-3.5"
                ]}
              >
                {link.name}
                {link.hasDropdown && (
                  <svg class="w-3.5 h-3.5 opacity-80 group-hover:rotate-180 group-focus-within:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
                  </svg>
                )}
              </a>

              {/* Dropdown accesible tanto en hover como en foco con teclado (focus-within) */}
              {link.hasDropdown && link.subItems.length > 0 && (
                <div class="absolute left-0 top-full w-64 opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible transition-all duration-150 z-50">
                  <div class="bg-white shadow-xl border border-gray-200 py-1.5 rounded-b-lg">
                    {link.subItems.map((sub) => (
                      <a
                        href={sub.href}
                        class="block px-4 py-2.5 text-sm text-gray-800 hover:bg-unlu-green/10 hover:text-unlu-green focus:bg-unlu-green/15 focus:text-unlu-green focus:outline-none font-medium transition-colors"
                      >
                        {sub.name}
                      </a>
                    ))}
                  </div>
                </div>
              )}
            </div>
          );
        })}
      </div>
    </div>
  </nav>

  <!-- Panel Menú Mobile: Drawer accesible -->
  <div
    class="fixed inset-x-0 bottom-0 top-[83px] z-40 hidden md:hidden"
    id="mobile-menu"
    role="dialog"
    aria-modal="true"
    aria-label="Menú de navegación móvil"
  >
    <!-- Fondo oscuro con efecto blur -->
    <div
      class="absolute inset-0 bg-black/40 backdrop-blur-sm transition-opacity duration-300"
      id="mobile-menu-backdrop"
    ></div>

    <!-- Panel lateral derecho -->
    <div class="absolute top-0 right-0 bottom-0 w-[85%] max-w-sm bg-white border-l border-gray-200 shadow-2xl overflow-y-auto">
      
      <!-- Buscador Mobile -->
      <div class="p-4 border-b border-gray-100 bg-gray-50/70" id="mobile-search-container">
        <div class="relative flex items-center rounded-xl overflow-hidden border border-gray-300 bg-white shadow-xs focus-within:border-unlu-green focus-within:ring-2 focus-within:ring-unlu-green/20">
          <input
            type="search"
            id="mobile-search-input"
            placeholder="Buscar SIAC, PDI, resoluciones..."
            autocomplete="off"
            aria-label="Buscar en el portal (móvil)"
            class="w-full px-3.5 py-2.5 text-sm text-gray-800 placeholder:text-gray-400 bg-transparent focus:outline-none"
          />
          <button type="button" id="mobile-search-submit" class="px-3 py-2.5 text-unlu-green hover:bg-unlu-green/5" aria-label="Buscar">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </button>
        </div>
        <div
          id="mobile-search-results"
          class="hidden mt-2 bg-white rounded-xl border border-gray-200 divide-y divide-gray-100 max-h-64 overflow-y-auto shadow-lg"
        ></div>
      </div>

      <div class="px-4 pt-3 pb-6 space-y-1">
        {navLinks.map((link) => (
          <div>
            <a
              href={link.href}
              class:list={[
                "block px-3 py-2.5 text-base font-semibold rounded-md focus:outline-none focus:ring-2 focus:ring-unlu-green",
                activeSection === link.id
                  ? "text-unlu-green bg-unlu-green/5"
                  : "text-gray-800 hover:text-unlu-green hover:bg-gray-50"
              ]}
            >
              {link.name}
            </a>
            {link.subItems.length > 0 && (
              <div class="pl-5 space-y-0.5 mt-0.5">
                {link.subItems.map((sub) => (
                  <a
                    href={sub.href}
                    class="block px-3 py-1.5 text-sm text-gray-600 hover:text-unlu-green rounded-md focus:outline-none focus:ring-2 focus:ring-unlu-green"
                  >
                    {sub.name}
                  </a>
                ))}
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </div>
</header>

<script>
  // ==========================================
  // MENÚ MÓVIL (DRAWER)
  // ==========================================
  const menuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');
  const backdrop = document.getElementById('mobile-menu-backdrop');

  function openMenu() {
    if (!mobileMenu || !menuButton || !iconOpen || !iconClose) return;
    mobileMenu.classList.remove('hidden');
    menuButton.setAttribute('aria-expanded', 'true');
    iconOpen.classList.add('hidden');
    iconClose.classList.remove('hidden');
  }

  function closeMenu() {
    if (!mobileMenu || !menuButton || !iconOpen || !iconClose) return;
    mobileMenu.classList.add('hidden');
    menuButton.setAttribute('aria-expanded', 'false');
    iconOpen.classList.remove('hidden');
    iconClose.classList.add('hidden');
  }

  if (menuButton) {
    menuButton.addEventListener('click', () => {
      const isExpanded = menuButton.getAttribute('aria-expanded') === 'true';
      if (isExpanded) {
        closeMenu();
      } else {
        openMenu();
      }
    });
  }

  if (backdrop) {
    backdrop.addEventListener('click', closeMenu);
  }

  // Cerrar menú móvil automáticamente si se hace clic en cualquier enlace interno/ancla
  if (mobileMenu) {
    const mobileLinks = mobileMenu.querySelectorAll('a');
    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        closeMenu();
      });
    });
  }

  // Actualizar enlace de inicio de sesión en Navbar
  const navAdminLink = document.getElementById('nav-admin-link');
  if (navAdminLink) {
    const isLoggedIn = localStorage.getItem('unlu_admin_logged_in') === 'true';
    if (isLoggedIn) {
      navAdminLink.innerHTML = '<span>🔐 Dashboard Admin</span>';
    } else {
      navAdminLink.innerHTML = '<span>🔑 Iniciar Sesión</span>';
    }
  }

  // Smooth scroll a subsección al hacer clic en enlaces con #hash
  document.addEventListener('click', (e) => {
    const link = (e.target as HTMLElement)?.closest('a');
    if (!link) return;
    const href = link.getAttribute('href');
    if (!href || !href.includes('#')) return;

    const parts = href.split('#');
    const path = parts[0];
    const hash = parts[1];

    if (hash) {
      const normalizePath = (p: string) => p.replace(/\/$/, '') || '/';
      const isCurrentPage = path === '' || normalizePath(path) === normalizePath(window.location.pathname);
      if (isCurrentPage) {
        const targetEl = document.getElementById(hash);
        if (targetEl) {
          e.preventDefault();
          targetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
          history.pushState(null, '', '#' + hash);
        }
      }
    }
  });

  // Auto-scroll al cargar la página si la URL contiene #hash (ej: /autoevaluacion#encuestas)
  function handleInitialHashScroll() {
    if (window.location.hash) {
      const hash = window.location.hash.substring(1);
      const targetEl = document.getElementById(hash);
      if (targetEl) {
        setTimeout(() => {
          targetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }, 300);
      }
    }
  }

  if (document.readyState === 'complete') {
    handleInitialHashScroll();
  } else {
    window.addEventListener('load', handleInitialHashScroll);
  }

  // ==========================================
  // MOTOR DE BÚSQUEDA EN VIVO (DESKTOP & MOBILE)
  // ==========================================
  interface SearchItem {
    title: string;
    category: string;
    badgeColor: string;
    url: string;
    keywords: string[];
    snippet: string;
    isExternal?: boolean;
  }

  const SEARCH_INDEX: SearchItem[] = [
    // --- SIAC ---
    {
      title: "¿Qué es el SIAC?",
      category: "SIAC",
      badgeColor: "bg-emerald-100 text-emerald-800 border-emerald-300",
      url: "/siac#que-es",
      keywords: ["siac", "que es", "sistema institucional aseguramiento calidad", "resolucion 890", "mejora continua", "calidad", "expediente 1101/2025"],
      snippet: "Estructura institucional permanente aprobada por Resolución RESHCS: 890/2025 para la mejora continua en docencia, investigación, extensión y gestión."
    },
    {
      title: "Beneficios y Objetivos del SIAC",
      category: "SIAC",
      badgeColor: "bg-emerald-100 text-emerald-800 border-emerald-300",
      url: "/siac#beneficios",
      keywords: ["beneficios", "objetivos", "siac", "coneau", "cultura de evaluacion", "planificacion", "indicadores", "transparencia", "claustros"],
      snippet: "Fortalecimiento de la planificación, participación democrática de claustros, articulación con estándares CONEAU y decisiones basadas en datos."
    },
    {
      title: "¿A quién está orientado el SIAC?",
      category: "SIAC",
      badgeColor: "bg-emerald-100 text-emerald-800 border-emerald-300",
      url: "/siac#destinatarios",
      keywords: ["destinatarios", "estudiantes", "docentes", "nodocentes", "graduados", "sedes", "centros regionales", "campana", "chivilcoy", "san miguel"],
      snippet: "Orientado a toda la comunidad universitaria: estudiantes, docentes, personal nodocente, graduados y unidades académicas de la UNLu."
    },
    {
      title: "Unidad de Calidad Institucional y Gestión del SIAC",
      category: "SIAC",
      badgeColor: "bg-emerald-100 text-emerald-800 border-emerald-300",
      url: "/siac#gestion",
      keywords: ["gestion", "conformacion", "unidad de calidad institucional", "rectorado", "direccion de evaluacion", "secretaria ejecutiva", "departamentos"],
      snippet: "Conformada por representantes de departamentos académicos, rectorado, dirección de evaluación y claustros del HCS."
    },
    {
      title: "Marco Normativo del SIAC",
      category: "SIAC",
      badgeColor: "bg-emerald-100 text-emerald-800 border-emerald-300",
      url: "/siac#marco-normativo",
      keywords: ["marco normativo", "resolucion 2597/2023", "acuerdo plenario 272", "resolucion rector 577/2024", "estatuto universitario", "articulo 53"],
      snippet: "Surge por Resolución Ministerial N° 2597/2023, Acuerdo Plenario N° 272 y Resoluciones UNLu RR: 577/2024 y RESHCS: 890/2025."
    },
    {
      title: "Resolución de Creación del SIAC (PDF)",
      category: "Documento PDF",
      badgeColor: "bg-red-100 text-red-800 border-red-300",
      url: "/RESO-SIAC.pdf",
      isExternal: true,
      keywords: ["resolucion siac pdf", "descargar siac", "reso siac", "hcs 890/2025", "documento oficial"],
      snippet: "Descarga directa de la Resolución H. Consejo Superior RESHCS: 890/2025."
    },

    // --- PLAN DE DESARROLLO INSTITUCIONAL ---
    {
      title: "¿Qué es el Plan de Desarrollo Institucional (PDI 2026–2036)?",
      category: "PDI",
      badgeColor: "bg-blue-100 text-blue-800 border-blue-300",
      url: "/plan-desarrollo#pdi",
      keywords: ["pdi", "plan de desarrollo", "2026-2036", "mision", "vision", "propuesta", "estrategia", "matricula", "titulaciones", "carreras"],
      snippet: "Documento rector decenal aprobado por RESHCS: 492/2026 que orienta el crecimiento, políticas y presupuesto de la UNLu hacia el 2036."
    },
    {
      title: "Resolución de Aprobación del PDI (RESHCS: 492/2026)",
      category: "PDI",
      badgeColor: "bg-blue-100 text-blue-800 border-blue-300",
      url: "/plan-desarrollo#resolucion",
      keywords: ["resolucion pdi", "reshcs 492/2026", "exp 633/2024", "anexo unico", "consejo superior", "aprobacion"],
      snippet: "Aprobación formal del PDI 2026–2036 por el Honorable Consejo Superior en su sesión del 16 de julio de 2026."
    },
    {
      title: "Metodología en 7 Etapas y Diagnóstico del PDI",
      category: "PDI",
      badgeColor: "bg-blue-100 text-blue-800 border-blue-300",
      url: "/plan-desarrollo#metodologia-diagnostico",
      keywords: ["metodologia", "7 etapas", "diagnostico", "foda", "fortalezas", "debilidades", "abandono temprano", "desvio de duracion", "interinatos"],
      snippet: "Proceso metodológico participativo, fortalezas y desafíos a resolver: abandono inicial del 48,7%, concursos docentes e infraestructura."
    },
    {
      title: "6 Dimensiones Estratégicas del PDI",
      category: "PDI",
