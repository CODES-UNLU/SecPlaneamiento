<script is:inline>
  // Estructura de almacenamiento dinámico predeterminado
  const DEFAULT_DYNAMIC_DATA = {
    banner: {
      active: true,
      style: "gold",
      text: "Convocatoria abierta para la presentación de Proyectos y Propuestas en el marco del PDI 2026–2036.",
