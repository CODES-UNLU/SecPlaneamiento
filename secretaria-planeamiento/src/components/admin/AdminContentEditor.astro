        },
        {
          q: "¿Dónde descargo las resoluciones oficiales del HCS y el texto del PDI?",
          a: "En el Repositorio Documental tenés disponibles en PDF la Resolución RESHCS: 492/2026, la RESHCS: 890/2025 y la propuesta completa del PDI 2026–2036."
        },
        {
          q: "¿En qué horario y lugar físico puedo realizar una consulta presencial?",
          a: "De lunes a viernes de 8:00 a 16:00 hs. en el Edificio 8 — Rectorado (Sede Central Luján)."
        }
      ]
    },
    documentos: [
      {
        id: "doc-1",
        code: "RESHCS: 492/2026",
        name: "Aprobación y Puesta en Marcha del Plan de Desarrollo Institucional Decenal (PDI 2026–2036)",
        category: "Resolución HCS",
        date: "Marzo 2026",
        url: "#"
      },
      {
        id: "doc-2",
        code: "RESHCS: 890/2025",
        name: "Informe Final Consolidado de la Autoevaluación Institucional UNLu (Fase Diagnóstica)",
        category: "Autoevaluación",
        date: "Diciembre 2025",
        url: "#"
      },
      {
        id: "doc-3",
        code: "Res. AU 006/00",
        name: "Estatuto y Estructura Funcional de la Secretaría de Planeamiento",
        category: "Guía Metodológica",
        date: "Año 2000",
        url: "#"
      }
    ],
    novedades: [
      {
        id: "news-1",
        title: "Taller participativo de socialización del PDI con Departamentos Académicos",
        date: "Septiembre 2026",
        tag: "Participación",
        summary: "Se llevaron a cabo reuniones de trabajo con los 4 Departamentos Académicos para articular los proyectos prioritarios con las metas decenales."
      },
      {
        id: "news-2",
        title: "Lanzamiento del Portal Digital de Planeamiento y Autoevaluación",
        date: "Agosto 2026",
        tag: "Institucional",
        summary: "La Secretaría de Planeamiento presentó el nuevo entorno digital interactivo para el seguimiento de metas, consulta de normativas y carga de proyectos."
      }
    ]
  };

  // Cargar datos desde localStorage o Defaults
  function getDynamicData() {
    const saved = localStorage.getItem('unlu_site_dynamic_content');
    if (saved) {
      try {
        return JSON.parse(saved);
      } catch (e) {
        console.error("Error parsing saved dynamic data", e);
      }
    }
    return DEFAULT_DYNAMIC_DATA;
  }

  function saveDynamicData(data) {
    localStorage.setItem('unlu_site_dynamic_content', JSON.stringify(data));
    sessionStorage.removeItem('unlu_banner_dismissed');
    window.dispatchEvent(new Event('storage'));
    showToast("Cambios guardados con éxito.");
  }

  function showToast(msg) {
    const toast = document.getElementById('editor-toast');
    const toastMsg = document.getElementById('toast-message');
    if (toast && toastMsg) {
      toastMsg.textContent = msg;
      toast.classList.remove('translate-y-20', 'opacity-0');
      setTimeout(() => {
        toast.classList.add('translate-y-20', 'opacity-0');
      }, 2500);
    }
  }

  // Cambio de pestaña de módulos
  window.switchModule = function(modKey) {
    document.querySelectorAll('.module-pane').forEach(p => p.classList.add('hidden'));
    document.querySelectorAll('.mod-tab').forEach(t => t.classList.remove('active'));

    const targetPanel = document.getElementById('module-panel-' + modKey);
    const targetTab = document.getElementById('mod-tab-' + modKey);

    if (targetPanel) targetPanel.classList.remove('hidden');
    if (targetTab) targetTab.classList.add('active');
  };

  // 1. BANNER: Render y Listener
  function initBanner() {
    const data = getDynamicData().banner;
    const activeInput = document.getElementById('banner-active');
    const styleInput = document.getElementById('banner-style');
    const textInput = document.getElementById('banner-text');
    const btnTextInput = document.getElementById('banner-link-text');
    const urlInput = document.getElementById('banner-url');

    if (activeInput) activeInput.checked = data.active;
    if (styleInput) styleInput.value = data.style;
    if (textInput) textInput.value = data.text;
    if (btnTextInput) btnTextInput.value = data.btnText;
    if (urlInput) urlInput.value = data.url;

    updateBannerPreview();

    [activeInput, styleInput, textInput, btnTextInput, urlInput].forEach(el => {
      if (el) el.addEventListener('input', updateBannerPreview);
    });

    const form = document.getElementById('form-banner');
    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const current = getDynamicData();
        current.banner = {
          active: activeInput.checked,
          style: styleInput.value,
          text: textInput.value,
          btnText: btnTextInput.value,
          url: urlInput.value
        };
        saveDynamicData(current);
      });
    }
  }

  function updateBannerPreview() {
    const active = document.getElementById('banner-active')?.checked;
    const style = document.getElementById('banner-style')?.value || 'gold';
    const text = document.getElementById('banner-text')?.value || 'Texto de aviso...';
    const btnText = document.getElementById('banner-link-text')?.value || 'Ver Más';
    const url = document.getElementById('banner-url')?.value || '#';

    const box = document.getElementById('preview-banner-box');
    const badge = document.getElementById('preview-banner-badge');
    const textEl = document.getElementById('preview-banner-text');
    const btn = document.getElementById('preview-banner-btn');

    if (!box || !badge || !textEl || !btn) return;

    textEl.textContent = text;
    btn.textContent = btnText;
    btn.href = url;

    // Colores según estilo
    if (style === 'gold') {
      box.className = "p-4 rounded-xl border flex flex-col sm:flex-row sm:items-center justify-between gap-4 transition-all bg-amber-50 border-amber-300 text-amber-950";
      badge.className = "inline-block text-[10px] font-extrabold uppercase tracking-wider px-2 py-0.5 rounded-md mb-1 bg-amber-200 text-amber-900";
      btn.className = "shrink-0 px-4 py-2 rounded-xl text-xs font-bold shadow-xs text-center transition-transform active:scale-95 bg-unlu-green hover:bg-unlu-green-dark text-white";
    } else if (style === 'green') {
      box.className = "p-4 rounded-xl border flex flex-col sm:flex-row sm:items-center justify-between gap-4 transition-all bg-emerald-50 border-emerald-300 text-emerald-950";
      badge.className = "inline-block text-[10px] font-extrabold uppercase tracking-wider px-2 py-0.5 rounded-md mb-1 bg-emerald-200 text-emerald-900";
      btn.className = "shrink-0 px-4 py-2 rounded-xl text-xs font-bold shadow-xs text-center transition-transform active:scale-95 bg-emerald-700 hover:bg-emerald-800 text-white";
    } else if (style === 'blue') {
      box.className = "p-4 rounded-xl border flex flex-col sm:flex-row sm:items-center justify-between gap-4 transition-all bg-blue-50 border-blue-300 text-blue-950";
      badge.className = "inline-block text-[10px] font-extrabold uppercase tracking-wider px-2 py-0.5 rounded-md mb-1 bg-blue-200 text-blue-900";
      btn.className = "shrink-0 px-4 py-2 rounded-xl text-xs font-bold shadow-xs text-center transition-transform active:scale-95 bg-blue-700 hover:bg-blue-800 text-white";
    } else {
      box.className = "p-4 rounded-xl border flex flex-col sm:flex-row sm:items-center justify-between gap-4 transition-all bg-red-50 border-red-300 text-red-950";
      badge.className = "inline-block text-[10px] font-extrabold uppercase tracking-wider px-2 py-0.5 rounded-md mb-1 bg-red-200 text-red-900";
      btn.className = "shrink-0 px-4 py-2 rounded-xl text-xs font-bold shadow-xs text-center transition-transform active:scale-95 bg-red-700 hover:bg-red-800 text-white";
    }

    if (!active) {
      box.style.opacity = '0.4';
    } else {
      box.style.opacity = '1';
    }
  }

  // 2. DOCUMENTOS: Render y ABM
  function renderDocs() {
    const docs = getDynamicData().documentos || [];
    const tbody = document.getElementById('docs-tbody');
    if (!tbody) return;

    if (docs.length === 0) {
      tbody.innerHTML = `<tr><td colspan="6" class="p-6 text-center text-slate-400">No hay documentos registrados.</td></tr>`;
      return;
    }

    tbody.innerHTML = docs.map((doc, idx) => `
      <tr class="hover:bg-slate-50/80 transition-colors">
        <td class="px-4 py-3 font-bold text-slate-900">${doc.code}</td>
        <td class="px-4 py-3 font-medium text-slate-800">${doc.name}</td>
        <td class="px-4 py-3"><span class="bg-slate-100 text-slate-700 px-2 py-0.5 rounded text-[11px] font-semibold">${doc.category}</span></td>
        <td class="px-4 py-3 text-slate-500">${doc.date}</td>
        <td class="px-4 py-3">
          <a href="${doc.url}" target="_blank" class="text-unlu-green font-bold hover:underline inline-flex items-center gap-1">
            <span>Ver PDF</span> ↗
          </a>
        </td>
        <td class="px-4 py-3 text-right space-x-1">
          <button onclick="editDoc('${doc.id}')" class="p-1.5 text-slate-600 hover:text-unlu-green rounded hover:bg-slate-100" title="Editar">✏️</button>
          <button onclick="deleteDoc('${doc.id}')" class="p-1.5 text-slate-600 hover:text-red-600 rounded hover:bg-red-50" title="Eliminar">🗑️</button>
        </td>
      </tr>
    `).join('');
  }

  window.openAddDocModal = function() {
    document.getElementById('modal-doc-title').textContent = 'Agregar Nuevo Documento Oficial';
    document.getElementById('doc-id').value = '';
    document.getElementById('doc-code').value = '';
    document.getElementById('doc-name').value = '';
    document.getElementById('doc-category').value = 'Resolución HCS';
    document.getElementById('doc-date').value = 'Año 2026';
    document.getElementById('doc-url').value = '#';
    document.getElementById('modal-doc').classList.remove('hidden');
  };

  window.closeAddDocModal = function() {
    document.getElementById('modal-doc').classList.add('hidden');
  };

  window.editDoc = function(id) {
    const docs = getDynamicData().documentos || [];
    const doc = docs.find(d => d.id === id);
    if (!doc) return;

    document.getElementById('modal-doc-title').textContent = 'Editar Documento Oficial';
    document.getElementById('doc-id').value = doc.id;
    document.getElementById('doc-code').value = doc.code;
    document.getElementById('doc-name').value = doc.name;
    document.getElementById('doc-category').value = doc.category;
    document.getElementById('doc-date').value = doc.date;
    document.getElementById('doc-url').value = doc.url;
    document.getElementById('modal-doc').classList.remove('hidden');
  };

  window.deleteDoc = function(id) {
    if (!confirm('¿Deseas eliminar este documento del repositorio?')) return;
    const current = getDynamicData();
    current.documentos = current.documentos.filter(d => d.id !== id);
    saveDynamicData(current);
    renderDocs();
  };

  // Formulario Documento
  document.getElementById('form-doc-modal')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const id = document.getElementById('doc-id').value;
    const code = document.getElementById('doc-code').value.trim();
    const name = document.getElementById('doc-name').value.trim();
    const category = document.getElementById('doc-category').value;
    const date = document.getElementById('doc-date').value.trim();
    const url = document.getElementById('doc-url').value.trim();

    const current = getDynamicData();
    if (!current.documentos) current.documentos = [];

    if (id) {
      const idx = current.documentos.findIndex(d => d.id === id);
      if (idx !== -1) {
        current.documentos[idx] = { id, code, name, category, date, url };
      }
    } else {
      current.documentos.push({
        id: 'doc-' + Date.now(),
        code, name, category, date, url
      });
    }

    saveDynamicData(current);
    closeAddDocModal();
    renderDocs();
  });

  // 3. CONVOCATORIA: Init y Submit
  function initConvocatoria() {
    const data = getDynamicData().convocatoria || {};
    const estado = document.getElementById('convocatoria-estado');
    const plazo = document.getElementById('convocatoria-plazo');
    const url = document.getElementById('convocatoria-form-url');
    const inst = document.getElementById('convocatoria-instrucciones');

    if (estado) estado.value = data.estado || 'abierta';
    if (plazo) plazo.value = data.plazo || '';
    if (url) url.value = data.formUrl || '';
    if (inst) inst.value = data.instrucciones || '';

    document.getElementById('form-convocatoria')?.addEventListener('submit', (e) => {
      e.preventDefault();
      const current = getDynamicData();
      current.convocatoria = {
        estado: estado.value,
        plazo: plazo.value,
        formUrl: url.value,
        instrucciones: inst.value
      };
      saveDynamicData(current);
    });
  }

  // 4. CONTACTO Y FAQ
  function initContacto() {
    const data = getDynamicData().contacto || {};
    const tel = document.getElementById('contacto-telefono');
    const email = document.getElementById('contacto-email');
    const horario = document.getElementById('contacto-horario');
    const despacho = document.getElementById('int-despacho');
    const mesa = document.getElementById('int-mesa');
    const calidad = document.getElementById('int-calidad');

    if (tel) tel.value = data.telefono || '';
    if (email) email.value = data.email || '';
    if (horario) horario.value = data.horario || '';
    if (despacho) despacho.value = data.despachoInt || '1718';
    if (mesa) mesa.value = data.mesaInt || '1200';
    if (calidad) calidad.value = data.calidadInt || '1720';

    renderFaqs(data.faqs || []);

    document.getElementById('form-contacto')?.addEventListener('submit', (e) => {
      e.preventDefault();
      const current = getDynamicData();
      const faqItems = [];
      document.querySelectorAll('.faq-row').forEach(row => {
        const q = row.querySelector('.faq-q-input')?.value.trim();
        const a = row.querySelector('.faq-a-input')?.value.trim();
        if (q && a) faqItems.push({ q, a });
      });

      current.contacto = {
        telefono: tel.value,
        email: email.value,
        horario: horario.value,
        despachoInt: despacho.value,
        mesaInt: mesa.value,
        calidadInt: calidad.value,
        faqs: faqItems
      };
      saveDynamicData(current);
    });
  }

  function renderFaqs(faqs) {
    const container = document.getElementById('faq-container');
    if (!container) return;
    container.innerHTML = faqs.map((faq, i) => `
      <div class="faq-row p-3.5 bg-slate-50 border border-slate-200 rounded-xl space-y-2 relative group">
        <button type="button" onclick="this.closest('.faq-row').remove()" class="absolute top-2 right-2 text-slate-400 hover:text-red-600 font-bold text-sm" title="Quitar">&times;</button>
        <div>
          <label class="block text-[11px] font-bold text-slate-700 mb-0.5">Pregunta</label>
          <input type="text" class="faq-q-input w-full bg-white border border-slate-300 rounded-lg px-3 py-1.5 text-xs font-semibold" value="${faq.q}" />
        </div>
        <div>
          <label class="block text-[11px] font-bold text-slate-700 mb-0.5">Respuesta</label>
          <textarea rows="2" class="faq-a-input w-full bg-white border border-slate-300 rounded-lg p-2 text-xs font-medium">${faq.a}</textarea>
        </div>
      </div>
    `).join('');
  }

  window.addFaqRow = function() {
    const container = document.getElementById('faq-container');
    if (!container) return;
    const div = document.createElement('div');
    div.className = "faq-row p-3.5 bg-slate-50 border border-slate-200 rounded-xl space-y-2 relative group";
    div.innerHTML = `
      <button type="button" onclick="this.closest('.faq-row').remove()" class="absolute top-2 right-2 text-slate-400 hover:text-red-600 font-bold text-sm" title="Quitar">&times;</button>
      <div>
        <label class="block text-[11px] font-bold text-slate-700 mb-0.5">Pregunta</label>
        <input type="text" placeholder="Ej: ¿Quiénes pueden participar?" class="faq-q-input w-full bg-white border border-slate-300 rounded-lg px-3 py-1.5 text-xs font-semibold" />
      </div>
      <div>
        <label class="block text-[11px] font-bold text-slate-700 mb-0.5">Respuesta</label>
        <textarea rows="2" placeholder="Respuesta explicativa..." class="faq-a-input w-full bg-white border border-slate-300 rounded-lg p-2 text-xs font-medium"></textarea>
      </div>
    `;
    container.appendChild(div);
  };

  // 5. NOVEDADES
  function renderNews() {
    const news = getDynamicData().novedades || [];
    const container = document.getElementById('news-list-container');
    if (!container) return;

    if (news.length === 0) {
      container.innerHTML = `<div class="col-span-2 p-6 text-center text-slate-400">No hay novedades cargadas.</div>`;
      return;
    }

    container.innerHTML = news.map(n => `
      <div class="p-4 bg-slate-50 border border-slate-200 rounded-2xl space-y-2 hover:border-unlu-green/50 transition-all flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between text-[11px] text-slate-500 mb-1">
            <span class="bg-emerald-100 text-unlu-green px-2 py-0.5 rounded font-bold">${n.tag || 'General'}</span>
            <span>${n.date}</span>
          </div>
          <h3 class="text-sm font-bold text-slate-900 leading-snug">${n.title}</h3>
          <p class="text-xs text-slate-600 mt-1.5 leading-relaxed">${n.summary}</p>
        </div>
        <div class="flex justify-end gap-2 pt-2 border-t border-slate-200/60">
          <button onclick="editNews('${n.id}')" class="p-1 text-slate-500 hover:text-unlu-green text-xs font-bold">✏️ Editar</button>
          <button onclick="deleteNews('${n.id}')" class="p-1 text-slate-500 hover:text-red-600 text-xs font-bold">🗑️ Eliminar</button>
        </div>
      </div>
    `).join('');
  }

  window.openAddNewsModal = function() {
    document.getElementById('modal-news-title').textContent = 'Publicar Nueva Novedad';
    document.getElementById('news-id').value = '';
    document.getElementById('news-title-input').value = '';
    document.getElementById('news-date-input').value = 'Septiembre 2026';
    document.getElementById('news-tag-input').value = 'Institucional';
    document.getElementById('news-summary-input').value = '';
    document.getElementById('modal-news').classList.remove('hidden');
  };

  window.closeAddNewsModal = function() {
    document.getElementById('modal-news').classList.add('hidden');
  };

  window.editNews = function(id) {
    const list = getDynamicData().novedades || [];
    const item = list.find(n => n.id === id);
    if (!item) return;

    document.getElementById('modal-news-title').textContent = 'Editar Novedad';
    document.getElementById('news-id').value = item.id;
    document.getElementById('news-title-input').value = item.title;
    document.getElementById('news-date-input').value = item.date;
    document.getElementById('news-tag-input').value = item.tag;
    document.getElementById('news-summary-input').value = item.summary;
    document.getElementById('modal-news').classList.remove('hidden');
  };

  window.deleteNews = function(id) {
    if (!confirm('¿Deseas eliminar esta novedad?')) return;
    const current = getDynamicData();
    current.novedades = current.novedades.filter(n => n.id !== id);
    saveDynamicData(current);
    renderNews();
  };

  document.getElementById('form-news-modal')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const id = document.getElementById('news-id').value;
    const title = document.getElementById('news-title-input').value.trim();
    const date = document.getElementById('news-date-input').value.trim();
    const tag = document.getElementById('news-tag-input').value.trim();
    const summary = document.getElementById('news-summary-input').value.trim();

    const current = getDynamicData();
    if (!current.novedades) current.novedades = [];

    if (id) {
      const idx = current.novedades.findIndex(n => n.id === id);
      if (idx !== -1) {
        current.novedades[idx] = { id, title, date, tag, summary };
      }
    } else {
      current.novedades.unshift({
        id: 'news-' + Date.now(),
        title, date, tag, summary
      });
    }

    saveDynamicData(current);
    closeAddNewsModal();
    renderNews();
  });

  // Exportar e Importar / Reset
  document.getElementById('btn-export-json')?.addEventListener('click', () => {
    const data = getDynamicData();
    const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'planeamiento-contenidos-dinamicos.json';
    a.click();
    URL.revokeObjectURL(url);
  });

  document.getElementById('btn-reset-defaults')?.addEventListener('click', () => {
    if (confirm('¿Restablecer todos los contenidos dinámicos a sus valores iniciales?')) {
      localStorage.removeItem('unlu_site_dynamic_content');
      initBanner();
      renderDocs();
      initConvocatoria();
      initContacto();
      renderNews();
      showToast("Valores restablecidos por defecto.");
    }
  });

  // Inicializar todos los módulos
  initBanner();
  renderDocs();
  initConvocatoria();
  initContacto();
  renderNews();
</script>
