---
/**
 * Componente: AdminContentEditor
 * Editor enfocado en contenidos dinámicos y operativos:
 * - 📢 Avisos y Banners Destacados
 * - 📄 Repositorio de Documentos y Resoluciones HCS
 * - 📋 Convocatorias y Formulario de Proyectos PDI
 * - 📞 Canales de Atención, Internos y FAQ
 * - 📰 Bitácora de Novedades y Avances
 * - 🔒 Visor de Contenidos Institucionales Protegidos (Misión, Dimensiones, Metas 2036)
 */
import autoevaluacionData from "../../data/pages/autoevaluacion.json";
import planDesarrolloData from "../../data/pages/plan-desarrollo.json";
import laSecretariaData from "../../data/pages/la-secretaria.json";
import contactoData from "../../data/pages/contacto.json";
import siacData from "../../data/pages/siac.json";

const SERVER_DATA = {
  autoevaluacion: autoevaluacionData,
  "plan-desarrollo": planDesarrolloData,
  "la-secretaria": laSecretariaData,
  contacto: contactoData,
  siac: siacData,
};
---

<script is:inline set:html={`window.SERVER_DATA = ${JSON.stringify(SERVER_DATA)};`} />

<div class="space-y-6" id="admin-editor-root">

  <!-- Toast Notification -->
  <div id="editor-toast" class="fixed bottom-6 right-6 z-50 transform translate-y-20 opacity-0 transition-all duration-300 bg-slate-900 text-white px-5 py-3.5 rounded-2xl shadow-2xl flex items-center gap-3 border border-emerald-500/30 text-xs sm:text-sm font-medium pointer-events-none">
    <div class="w-6 h-6 rounded-full bg-unlu-green flex items-center justify-center text-white shrink-0 font-bold">✓</div>
    <span id="toast-message">Cambios guardados exitosamente.</span>
  </div>

  <!-- Encabezado Principal del Editor -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-white p-5 rounded-2xl border border-slate-200/80 shadow-xs">
    <div>
      <div class="flex items-center gap-2 text-xs font-semibold text-slate-500 mb-1">
        <a href="/admin" class="hover:text-unlu-green">Dashboard</a>
        <span>/</span>
        <span class="text-slate-900 font-bold">Gestión de Contenidos</span>
      </div>
      <h1 class="text-xl sm:text-2xl font-bold text-slate-900 font-sans flex items-center gap-2 flex-wrap">
        <span>Editor de Contenidos Dinámicos</span>
        <span class="text-xs bg-emerald-100 text-unlu-green border border-emerald-300 font-semibold px-2.5 py-0.5 rounded-full">
          Módulos Operativos Activos
        </span>
      </h1>
      <p class="text-xs text-slate-500 mt-0.5">
        Actualizá las secciones que cambian periódicamente (documentos, convocatorias, contactos y avisos). Los textos estatutarios y normativos se mantienen protegidos.
      </p>
    </div>

    <div class="flex items-center gap-2">
      <button
        type="button"
        id="btn-export-json"
        class="inline-flex items-center gap-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-xs px-3.5 py-2.5 rounded-xl transition-all cursor-pointer"
        title="Descargar respaldo de configuración"
      >
        <svg class="w-4 h-4 text-slate-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
        </svg>
        <span>Exportar Datos</span>
      </button>

      <button
        type="button"
        id="btn-reset-defaults"
        class="inline-flex items-center gap-1.5 bg-red-50 hover:bg-red-100 text-red-700 border border-red-200 font-semibold text-xs px-3.5 py-2.5 rounded-xl transition-all cursor-pointer"
        title="Restablecer valores predeterminados"
      >
        <svg class="w-4 h-4 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
        </svg>
        <span>Restablecer</span>
      </button>
    </div>
  </div>

  <!-- Navegación por Módulos Operativos -->
  <div class="flex items-center gap-2 overflow-x-auto pb-2 border-b border-slate-200">
    <button
      type="button"
      onclick="switchModule('banner')"
      id="mod-tab-banner"
      class="mod-tab active shrink-0 px-4 py-2.5 rounded-xl text-xs font-bold transition-all flex items-center gap-2 cursor-pointer"
    >
      <span>📢</span>
      <span>Avisos & Banners</span>
    </button>

    <button
      type="button"
      onclick="switchModule('documents')"
      id="mod-tab-documents"
      class="mod-tab shrink-0 px-4 py-2.5 rounded-xl text-xs font-bold transition-all flex items-center gap-2 cursor-pointer"
    >
      <span>📄</span>
      <span>Documentos & Resoluciones</span>
    </button>

    <button
      type="button"
      onclick="switchModule('convocatoria')"
      id="mod-tab-convocatoria"
      class="mod-tab shrink-0 px-4 py-2.5 rounded-xl text-xs font-bold transition-all flex items-center gap-2 cursor-pointer"
    >
      <span>📋</span>
      <span>Formulario & Proyectos PDI</span>
    </button>

    <button
      type="button"
      onclick="switchModule('contacto')"
      id="mod-tab-contacto"
      class="mod-tab shrink-0 px-4 py-2.5 rounded-xl text-xs font-bold transition-all flex items-center gap-2 cursor-pointer"
    >
      <span>📞</span>
      <span>Canales de Contacto & FAQ</span>
    </button>

    <button
      type="button"
      onclick="switchModule('novedades')"
      id="mod-tab-novedades"
      class="mod-tab shrink-0 px-4 py-2.5 rounded-xl text-xs font-bold transition-all flex items-center gap-2 cursor-pointer"
    >
      <span>📰</span>
      <span>Novedades y Bitácora</span>
    </button>

    <button
      type="button"
      onclick="switchModule('protegido')"
      id="mod-tab-protegido"
      class="mod-tab shrink-0 px-4 py-2.5 rounded-xl text-xs font-bold transition-all flex items-center gap-2 cursor-pointer bg-slate-100 text-slate-600 hover:bg-slate-200 border border-slate-300"
    >
      <span>🔒</span>
      <span>Contenido Normativo Protegido</span>
    </button>
  </div>

  <!-- ========================================== -->
  <!-- MÓDULO 1: AVISOS Y BANNERS DESTACADOS -->
  <!-- ========================================== -->
  <div id="module-panel-banner" class="module-pane space-y-6">
    <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-xs space-y-6">
      <div class="flex items-start justify-between gap-4 border-b border-slate-100 pb-4">
        <div>
          <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
            <span>📢</span>
            <span>Banner Superior de Aviso / Novedad Destacada</span>
          </h2>
          <p class="text-xs text-slate-500 mt-1">
            Configurá un aviso visible en la cabecera de todas las páginas para convocatorias importantes, alertas de plazos o anuncios institucionales.
          </p>
        </div>
        <span class="inline-flex items-center gap-1.5 bg-emerald-50 text-emerald-700 text-xs font-bold px-3 py-1 rounded-full border border-emerald-200">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> Dinámico
        </span>
      </div>

      <!-- Vista previa del Banner -->
      <div>
        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
          Vista Previa en Vivo
        </label>
        <div id="preview-banner-box" class="p-4 rounded-xl border flex flex-col sm:flex-row sm:items-center justify-between gap-4 transition-all">
          <div class="flex items-start gap-3">
            <span id="preview-banner-icon" class="text-2xl">📢</span>
            <div>
              <span id="preview-banner-badge" class="inline-block text-[10px] font-extrabold uppercase tracking-wider px-2 py-0.5 rounded-md mb-1">
                AVISO DESTACADO
              </span>
              <p id="preview-banner-text" class="text-xs sm:text-sm font-semibold leading-snug">
                Cargando aviso...
              </p>
            </div>
          </div>
          <a
            id="preview-banner-btn"
            href="#"
            target="_blank"
            class="shrink-0 px-4 py-2 rounded-xl text-xs font-bold shadow-xs text-center transition-transform active:scale-95"
          >
            Ver Información →
          </a>
        </div>
      </div>

      <!-- Formulario de Edición del Banner -->
      <form id="form-banner" class="space-y-4 pt-2">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <!-- Estado Activo/Inactivo -->
          <div class="flex items-center gap-3 p-3.5 bg-slate-50 rounded-xl border border-slate-200">
            <input type="checkbox" id="banner-active" class="w-4 h-4 text-unlu-green rounded focus:ring-unlu-green" />
            <div>
              <label for="banner-active" class="text-xs font-bold text-slate-800 cursor-pointer">Mostrar Banner en el Sitio</label>
              <p class="text-[11px] text-slate-500">Si se desactiva, no se mostrará en el encabezado del portal.</p>
            </div>
          </div>

          <!-- Estilo / Color -->
          <div>
            <label for="banner-style" class="block text-xs font-bold text-slate-700 mb-1">Estilo Visual</label>
            <select id="banner-style" class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2.5 text-xs text-slate-800 font-medium">
              <option value="gold">Dorado Institucional (Alerta / Convocatoria)</option>
              <option value="green">Verde UNLu (Institucional / Informativo)</option>
              <option value="blue">Azul SIAC (Calidad / Evaluación)</option>
              <option value="red">Rojo Urgente (Plazo límite)</option>
            </select>
          </div>
        </div>

        <div>
          <label for="banner-text" class="block text-xs font-bold text-slate-700 mb-1">Texto del Mensaje</label>
          <input
            type="text"
            id="banner-text"
            placeholder="Ej: Convocatoria a Proyectos PDI abierta hasta el 30 de Noviembre..."
            class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2.5 text-xs text-slate-800 font-medium focus:bg-white focus:ring-2 focus:ring-unlu-green outline-none"
          />
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label for="banner-link-text" class="block text-xs font-bold text-slate-700 mb-1">Texto del Botón</label>
            <input
              type="text"
              id="banner-link-text"
              placeholder="Ej: Presentar Proyecto ↗"
              class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2.5 text-xs text-slate-800 font-medium focus:bg-white focus:ring-2 focus:ring-unlu-green outline-none"
            />
          </div>

          <div>
            <label for="banner-url" class="block text-xs font-bold text-slate-700 mb-1">Enlace / URL de Destino</label>
            <input
              type="text"
              id="banner-url"
              placeholder="Ej: https://docs.google.com/... o /plan-desarrollo"
              class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2.5 text-xs text-slate-800 font-medium focus:bg-white focus:ring-2 focus:ring-unlu-green outline-none"
            />
          </div>
        </div>

        <div class="flex justify-end pt-3 border-t border-slate-100">
          <button
            type="submit"
            class="bg-unlu-green hover:bg-unlu-green-dark text-white font-bold text-xs px-5 py-2.5 rounded-xl shadow-md transition-all flex items-center gap-2 cursor-pointer active:scale-95"
          >
            <span>💾 Guardar Banner</span>
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- ========================================== -->
  <!-- MÓDULO 2: DOCUMENTOS Y RESOLUCIONES HCS -->
  <!-- ========================================== -->
  <div id="module-panel-documents" class="module-pane hidden space-y-6">
    <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-xs space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-100 pb-4">
        <div>
          <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
            <span>📄</span>
            <span>Repositorio de Resoluciones y Documentos Oficiales</span>
          </h2>
          <p class="text-xs text-slate-500 mt-1">
            Administrá las resoluciones del HCS, planes de trabajo e informes técnicos descargables en PDF.
          </p>
        </div>
        <button
          type="button"
          onclick="openAddDocModal()"
          class="inline-flex items-center gap-2 bg-unlu-green hover:bg-unlu-green-dark text-white font-bold text-xs px-4 py-2.5 rounded-xl shadow-md transition-transform active:scale-95 cursor-pointer shrink-0"
        >
          <span>+ Agregar Nuevo Documento / Resolución</span>
        </button>
      </div>

      <!-- Tabla de Documentos -->
      <div class="overflow-x-auto border border-slate-200 rounded-xl">
        <table class="w-full text-left text-xs">
          <thead class="bg-slate-50 text-slate-700 font-bold uppercase tracking-wider border-b border-slate-200">
            <tr>
              <th class="px-4 py-3">Resolución / Código</th>
              <th class="px-4 py-3">Título & Descripción</th>
              <th class="px-4 py-3">Categoría</th>
              <th class="px-4 py-3">Fecha</th>
              <th class="px-4 py-3">Archivo / PDF</th>
              <th class="px-4 py-3 text-right">Acciones</th>
            </tr>
          </thead>
          <tbody id="docs-tbody" class="divide-y divide-slate-100 font-medium text-slate-800">
            <!-- Renderizado dinámico -->
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- ========================================== -->
  <!-- MÓDULO 3: FORMULARIO Y PROYECTOS PDI -->
  <!-- ========================================== -->
  <div id="module-panel-convocatoria" class="module-pane hidden space-y-6">
    <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-xs space-y-6">
      <div class="border-b border-slate-100 pb-4">
        <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
          <span>📋</span>
          <span>Gestión de Convocatorias y Formulario de Proyectos PDI</span>
        </h2>
        <p class="text-xs text-slate-500 mt-1">
          Actualizá el enlace del formulario oficial de Google Forms, las fechas de cierre y las instrucciones para la presentación de iniciativas por parte de los claustros.
        </p>
      </div>

      <form id="form-convocatoria" class="space-y-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <!-- Estado de Convocatoria -->
          <div>
            <label for="convocatoria-estado" class="block text-xs font-bold text-slate-700 mb-1">Estado de la Convocatoria</label>
            <select id="convocatoria-estado" class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2.5 text-xs text-slate-800 font-medium">
              <option value="abierta">🟢 Abierta - Recepción activa de proyectos</option>
              <option value="evaluacion">🟡 En Evaluación por Comisiones</option>
              <option value="cerrada">🔴 Cerrada - Convocatoria finalizada</option>
            </select>
          </div>

          <!-- Fecha de Vencimiento / Plazo -->
          <div>
            <label for="convocatoria-plazo" class="block text-xs font-bold text-slate-700 mb-1">Fecha Límite / Plazo</label>
            <input
              type="text"
              id="convocatoria-plazo"
              placeholder="Ej: Hasta el 30 de Noviembre de 2026"
              class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2.5 text-xs text-slate-800 font-medium focus:bg-white focus:ring-2 focus:ring-unlu-green outline-none"
            />
          </div>
        </div>

        <!-- URL del Formulario Google Forms -->
        <div>
          <label for="convocatoria-form-url" class="block text-xs font-bold text-slate-700 mb-1">
            Enlace Oficial al Formulario de Proyectos (Google Forms / Plataforma)
          </label>
          <div class="relative">
            <input
              type="url"
              id="convocatoria-form-url"
              placeholder="https://docs.google.com/forms/d/e/..."
              class="w-full bg-slate-50 border border-slate-300 rounded-xl pl-9 pr-3 py-2.5 text-xs text-slate-800 font-medium focus:bg-white focus:ring-2 focus:ring-unlu-green outline-none"
            />
            <span class="absolute left-3 top-2.5 text-slate-400">🔗</span>
          </div>
        </div>

        <!-- Instrucciones / Resumen para Claustros -->
        <div>
          <label for="convocatoria-instrucciones" class="block text-xs font-bold text-slate-700 mb-1">
            Texto Guía para la Presentación de Propuestas
          </label>
          <textarea
            id="convocatoria-instrucciones"
            rows="3"
            class="w-full bg-slate-50 border border-slate-300 rounded-xl p-3 text-xs text-slate-800 font-medium focus:bg-white focus:ring-2 focus:ring-unlu-green outline-none"
            placeholder="Explicación breve de quiénes pueden presentar proyectos, requisitos formales y vinculación con las 6 dimensiones..."
          ></textarea>
        </div>

        <div class="flex justify-end pt-3 border-t border-slate-100">
          <button
            type="submit"
            class="bg-unlu-green hover:bg-unlu-green-dark text-white font-bold text-xs px-5 py-2.5 rounded-xl shadow-md transition-all flex items-center gap-2 cursor-pointer active:scale-95"
          >
            <span>💾 Guardar Ajustes de Convocatoria</span>
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- ========================================== -->
  <!-- MÓDULO 4: CANALES DE CONTACTO Y FAQ -->
  <!-- ========================================== -->
  <div id="module-panel-contacto" class="module-pane hidden space-y-6">
    <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-xs space-y-6">
      <div class="border-b border-slate-100 pb-4">
        <h2 class="text-base font-bold text-slate-900 flex items-center gap-2">
          <span>📞</span>
          <span>Canales de Contacto, Internos y Preguntas Frecuentes</span>
        </h2>
        <p class="text-xs text-slate-500 mt-1">
          Modificá los números de interno telefónico de cada área de la Secretaría, emails institucionales, horarios de atención y las preguntas frecuentes (FAQ).
        </p>
      </div>

      <form id="form-contacto" class="space-y-5">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          <!-- Teléfono Central -->
          <div>
            <label for="contacto-telefono" class="block text-xs font-bold text-slate-700 mb-1">Teléfono Conmutador Central</label>
            <input
              type="text"
              id="contacto-telefono"
              placeholder="+54 (02323) 445100"
              class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2.5 text-xs text-slate-800 font-medium focus:bg-white focus:ring-2 focus:ring-unlu-green outline-none"
            />
          </div>

          <!-- Email Principal -->
          <div>
            <label for="contacto-email" class="block text-xs font-bold text-slate-700 mb-1">Correo Electrónico Principal</label>
            <input
              type="email"
              id="contacto-email"
              placeholder="planeamiento@unlu.edu.ar"
              class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2.5 text-xs text-slate-800 font-medium focus:bg-white focus:ring-2 focus:ring-unlu-green outline-none"
            />
          </div>

          <!-- Horario de Atención -->
          <div>
            <label for="contacto-horario" class="block text-xs font-bold text-slate-700 mb-1">Horario de Atención Presencial</label>
            <input
              type="text"
              id="contacto-horario"
              placeholder="Lunes a viernes · 8:00 a 16:00 hs."
              class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2.5 text-xs text-slate-800 font-medium focus:bg-white focus:ring-2 focus:ring-unlu-green outline-none"
            />
          </div>
        </div>

        <!-- Internos por Área -->
        <div class="bg-slate-50 p-4 rounded-xl border border-slate-200 space-y-3">
          <span class="text-xs font-bold text-slate-700 uppercase tracking-wider block">Internos Telefónicos Directos</span>
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
            <div>
              <label for="int-despacho" class="block text-[11px] font-semibold text-slate-600 mb-1">🏛️ Despacho de Secretaría</label>
              <input type="text" id="int-despacho" placeholder="1718" class="w-full bg-white border border-slate-300 rounded-lg px-3 py-2 text-xs font-medium" />
            </div>
            <div>
              <label for="int-mesa" class="block text-[11px] font-semibold text-slate-600 mb-1">📥 Mesa General de Entradas</label>
              <input type="text" id="int-mesa" placeholder="1200" class="w-full bg-white border border-slate-300 rounded-lg px-3 py-2 text-xs font-medium" />
            </div>
            <div>
              <label for="int-calidad" class="block text-[11px] font-semibold text-slate-600 mb-1">🛡️ Aseguramiento de Calidad / SIAC</label>
              <input type="text" id="int-calidad" placeholder="1720" class="w-full bg-white border border-slate-300 rounded-lg px-3 py-2 text-xs font-medium" />
            </div>
          </div>
        </div>

        <!-- Preguntas Frecuentes (FAQ) -->
        <div>
          <div class="flex items-center justify-between mb-2">
            <label class="text-xs font-bold text-slate-700 uppercase tracking-wider">
              Preguntas Frecuentes (FAQ) en Contacto
            </label>
            <button
              type="button"
              onclick="addFaqRow()"
              class="text-xs text-unlu-green font-bold hover:underline"
            >
              + Agregar Pregunta
            </button>
          </div>
          <div id="faq-container" class="space-y-3">
            <!-- Renderizado dinámico de FAQs -->
          </div>
        </div>

        <div class="flex justify-end pt-3 border-t border-slate-100">
          <button
            type="submit"
            class="bg-unlu-green hover:bg-unlu-green-dark text-white font-bold text-xs px-5 py-2.5 rounded-xl shadow-md transition-all flex items-center gap-2 cursor-pointer active:scale-95"
          >
            <span>💾 Guardar Contacto y FAQ</span>
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- ========================================== -->
  <!-- MÓDULO 5: NOVEDADES Y BITÁCORA -->
  <!-- ========================================== -->
  <div id="module-panel-novedades" class="module-pane hidden space-y-6">
    <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-xs space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-100 pb-4">
        <div>
