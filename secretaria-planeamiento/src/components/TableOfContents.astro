---
/**
 * Componente: TableOfContents
 * Tabla de contenidos flotante/sticky para páginas institucionales extensas.
 */
interface HeadingItem {
  id: string;
  title: string;
}

interface Props {
  items: HeadingItem[];
}

const { items = [] } = Astro.props;
---

{items.length > 0 && (
  <nav class="hidden xl:block w-72 shrink-0" aria-label="Tabla de contenidos">
    <div class="sticky top-32 bg-white rounded-2xl border border-slate-200/90 p-5 shadow-sm max-h-[calc(100vh-10rem)] overflow-y-auto">
      <div class="flex items-center gap-2 mb-3 pb-2.5 border-b border-slate-100">
        <div class="w-6 h-6 rounded-lg bg-emerald-50 text-unlu-green flex items-center justify-center text-xs">
          📑
        </div>
        <span class="text-xs font-bold uppercase tracking-wider text-slate-800 font-sans">En esta página</span>
      </div>

      <ul class="space-y-1 text-xs">
        {items.map((it) => (
          <li>
            <a
              href={`#${it.id}`}
              class="toc-link block py-2 px-3 rounded-lg text-slate-600 hover:text-unlu-green hover:bg-slate-50 transition-all leading-snug border-l-2 border-transparent"
              data-target-id={it.id}
            >
              {it.title}
            </a>
          </li>
        ))}
      </ul>

      <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-[11px]">
        <button
          type="button"
          onclick="window.scrollTo({ top: 0, behavior: 'smooth' })"
          class="text-slate-500 hover:text-unlu-green font-semibold flex items-center gap-1 cursor-pointer"
        >
          <span>↑</span>
          <span>Volver arriba</span>
        </button>
      </div>
    </div>
  </nav>
)}

<script is:inline>
  (function() {
    const links = document.querySelectorAll('.toc-link');
    if (!links.length) return;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const id = entry.target.getAttribute('id');
          links.forEach((link) => {
            if (link.getAttribute('data-target-id') === id) {
              link.classList.add('font-bold', 'text-unlu-green', 'bg-emerald-50', 'border-l-2', 'border-unlu-green');
              link.classList.remove('text-slate-600');
            } else {
              link.classList.remove('font-bold', 'text-unlu-green', 'bg-emerald-50', 'border-l-2', 'border-unlu-green');
              link.classList.add('text-slate-600');
            }
          });
        }
      });
    }, { rootMargin: '-80px 0px -70% 0px' });

    links.forEach((link) => {
      const id = link.getAttribute('data-target-id');
      const target = document.getElementById(id);
      if (target) observer.observe(target);
    });
  })();
</script>
