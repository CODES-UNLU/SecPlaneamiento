---
/**
 * Página: SIAC - Sistema Institucional de Aseguramiento de la Calidad
 * Contenido gestionado desde src/data/pages/siac.json
 */
import Layout from "../layouts/Layout.astro";
import BlockRenderer from "../blocks/BlockRenderer.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import pageData from "../data/pages/siac.json";

const { meta, blocks } = pageData;
---

<Layout 
  title={meta.title} 
  description={meta.heroSubtitle || "Sistema Institucional de Aseguramiento de la Calidad (SIAC) de la Universidad Nacional de Luján."}
  activeSection={meta.activeSection}
>

  <!-- Cabecera Hero Accesible -->
  <section class="bg-gradient-to-r from-unlu-green to-unlu-green-dark text-white py-12 lg:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={[{ label: meta.heroTitle || "SIAC" }]} />

      <span class="inline-block text-xs font-bold tracking-[0.15em] uppercase text-unlu-gold mb-3" data-hero-badge>
        {meta.heroBadge}
      </span>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-white font-serif leading-tight max-w-4xl mb-4" data-hero-title>
        {meta.heroTitle}
      </h1>
      <p class="text-base sm:text-lg text-white/90 leading-relaxed max-w-3xl" data-hero-subtitle>
        {meta.heroSubtitle}
      </p>
    </div>
  </section>

  <!-- Contenido principal generado desde bloques JSON -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10" id="page-blocks-wrapper">
    <BlockRenderer blocks={blocks} />
  </div>

</Layout>

<script is:inline>
  (function() {
    try {
      const saved = JSON.parse(localStorage.getItem('unlu_blocks_v30') || '{}');
      const data = saved['siac'];
      if (!data) return;
      const meta = data.meta;
      if (meta) {
        if (meta.heroBadge) { document.querySelectorAll('[data-hero-badge]').forEach(el => el.textContent = meta.heroBadge); }
        if (meta.heroTitle) { document.querySelectorAll('[data-hero-title]').forEach(el => el.textContent = meta.heroTitle); }
        if (meta.heroSubtitle) { document.querySelectorAll('[data-hero-subtitle]').forEach(el => el.textContent = meta.heroSubtitle); }
      }
    } catch(e) {}
  })();
</script>
